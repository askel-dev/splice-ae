    "start": "node build/index.js"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "~1.9.0",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@types/node": "^20.17.30",
    "typescript": "^5.8.3"
  }
}
